{
	"name": "n8n-nodes-agentboxd",
	"version": "0.1.0",
	"description": "Agentboxd for n8n: real email inboxes for AI agents. Create inboxes, send and reply, wait for sign-up codes, and trigger workflows when mail arrives.",
	"license": "MIT",
	"homepage": "https://agentboxd.com/guides/n8n-email-automation",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"agentboxd",
		"email",
		"ai agents",
		"inbox",
		"verification code",
		"mcp"
	],
	"author": {
		"name": "Agentboxd",
		"email": "hello@agentboxd.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agentboxd/n8n-nodes-agentboxd.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/**/*.map"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AgentboxdApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Agentboxd/Agentboxd.node.js",
			"dist/nodes/AgentboxdTrigger/AgentboxdTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.49.1",
		"@types/node": "^22.20.4",
		"eslint": "9.39.4",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/agentboxd/n8n-nodes-agentboxd/issues"
	}
}
